<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- `local-packages` is git-ignored and normally empty. scripts/use-local-libs.sh fills it with
         a locally packed SExpressions stamped with a distinct version, which you then select with
         -p:SExpressionsVersion=<that version>. Nothing here changes a default restore: with the
         folder empty (or the default version requested) restore resolves from nuget.org. -->
    <add key="local-packages" value="local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
