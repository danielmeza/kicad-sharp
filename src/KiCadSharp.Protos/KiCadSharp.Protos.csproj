<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>KiCadSharp</RootNamespace>
    <!-- Generated protobuf code is not ours to keep warning-clean. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KiCadSharp.Protos</PackageId>
    <Description>Generated C# message types for KiCad's IPC API, compiled from the .proto definitions in
the KiCad source tree (the Kiapi.* namespaces). Shipped as its own package because these types appear
in KiCadSharp's public surface, so consumers have to be able to name them.</Description>
    <PackageTags>kicad;protobuf;ipc;eda;pcb;kiapi</PackageTags>
  </PropertyGroup>

  <!-- The .proto sources are vendored under protos/ at the repository root and pinned to a KiCad
       release tag by protos/KICAD_PIN. They used to come from a `submodules/kicad` git submodule,
       which cost a 1.4 GB checkout of the entire KiCad source tree per clone and per CI run to
       obtain 128 KB of interface definitions; scripts/sync-protos.sh re-fetches them from the pin
       and its `check` mode (run in CI) fails if the vendored copies have drifted from it.

       They are globbed and compiled in place. An earlier version copied them into obj/proto from a
       BeforeTargets="Build" target and globbed obj/proto in an ItemGroup; MSBuild evaluates items
       before any target runs, so the first build of a fresh clone always produced an empty assembly
       and every Kiapi.* type failed to resolve. Globbing the source directly removes that two-pass
       requirement. -->
  <PropertyGroup>
    <KiCadProtoRoot>$(MSBuildThisFileDirectory)../../protos/</KiCadProtoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="$(KiCadProtoRoot)**/*.proto" ProtoRoot="$(KiCadProtoRoot)" GrpcServices="None" />
  </ItemGroup>

  <!-- Fail loudly rather than silently emitting an empty assembly if the vendored tree goes missing. -->
  <Target Name="EnsureKiCadProtos" BeforeTargets="Protobuf_BeforeCompile;CoreCompile">
    <Error Condition="'@(Protobuf)' == ''"
           Text="No .proto files found under $(KiCadProtoRoot). Run: scripts/sync-protos.sh" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.1" />
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.83.0" />
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
  </ItemGroup>

</Project>
