<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>KiCadSharp</PackageId>
    <Description>A .NET client for KiCad. Talks to a running KiCad over its nng IPC API to read and edit
boards, schematics and project settings, and reads the on-disk s-expression formats (symbol and
footprint libraries, design rules) through SExpressions.</Description>
    <PackageTags>kicad;eda;pcb;schematic;footprint;symbol;ipc;nng</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../KiCadSharp.Protos/KiCadSharp.Protos.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SExpressions now ships from its own repository (danielmeza/sexpressions) as its own package.
         $(SExpressionsVersion) defaults to the released version; see README "Developing against local
         SExpressions sources" for the local-feed loop. -->
    <PackageReference Include="SExpressions" Version="$(SExpressionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.4" />
    <PackageReference Include="Rebus.nng" Version="8.6.1" />
  </ItemGroup>

</Project>
